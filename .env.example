# ---------------------------------------------------------------------------
# Discount Bot demo - example environment. Copy to .env and adjust.
# No real credentials belong in this file or in git. Broker creds are entered
# in the UI at runtime and held in memory only.
# ---------------------------------------------------------------------------

# HTTP
PORT=8080

# Demo password gate (required in production; defaults to "solace" in dev)
DEMO_PASSWORD=solace
# Secret used to sign the auth cookie. Change for any shared deployment.
SESSION_SECRET=change-me-in-production

# Simulators: publish the fake world. Turn off to point at a customer's topics.
SIMULATORS_ENABLED=true

# Broker mode: "mock" runs the whole demo with no broker (in-process bus).
# "solace" uses real credentials entered in the UI.
BROKER_MODE=mock

# Topic rebranding: one line to reskin every topic per prospect.
TOPIC_ROOT=acme/retail

# ---------------------------------------------------------------------------
# LLM layer. Provider: openai_compatible (default) | sap_ai_core | mock
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
# Default to the LiteLLM proxy on :4000 (start it with the litellm.config.yaml,
# see README). If LLM_BASE_URL is unset the app probes local proxies in order:
# http://localhost:4000/v1 (LiteLLM), :8000, :1234 (LM Studio), :11434 (Ollama),
# and falls back to the deterministic mock LLM if none answer.
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=discount-bot
# LLM_API_KEY=
LLM_TIMEOUT_MS=60000

# Cost estimate (USD per 1K tokens). If unset, the app applies plausible
# defaults (~GPT-4o-mini list pricing) so the cost meter shows a non-zero
# figure out of the box. Set these to your provider's real rates.
# LLM_PRICE_PER_1K_INPUT=0.003
# LLM_PRICE_PER_1K_OUTPUT=0.015

# ---------------------------------------------------------------------------
# SAP AI Core (optional). See docs/SAP_AI_SDK.md. Missing values must NOT break
# `npm run dev`; the provider is loaded lazily.
# ---------------------------------------------------------------------------
# AICORE_SERVICE_KEY={"clientid":"...","clientsecret":"...","url":"...","serviceurls":{"AI_API_URL":"..."}}
# AICORE_DEPLOYMENT_ID=
# AICORE_RESOURCE_GROUP=default
# AICORE_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Recommended demo path: LiteLLM proxy fronting SAP AI Core.
# The app points at LiteLLM (LLM_BASE_URL above), and LiteLLM routes the
# "discount-bot" model to SAP AI Core using the same AICORE_* values below.
# When these are unset, LiteLLM falls back to the local Ollama model, so the
# demo keeps working offline. Pass these into the litellm process/container:
#   AICORE_SERVICE_KEY   full service key JSON from SAP BTP
#   AICORE_RESOURCE_GROUP   usually "default"
# ---------------------------------------------------------------------------
